APP_ENV=development
DATABASE_URL=your_database_url_here
RETELL_API_KEY=your_retell_api_key_here
RETELL_SIGNATURE_BYPASS=false
BUSINESS_CONFIG_PATH=business.local.json
POSTGRES_USER=your_local_postgres_user_here
POSTGRES_PASSWORD=your_local_postgres_password_here
POSTGRES_DB=your_local_postgres_database_here
# Optional staging-only dashboard access; set real secrets in Railway Variables.
# DEMO_DASHBOARD_USERNAME=
# DEMO_DASHBOARD_PASSWORD=
# Calendar: defaults to fake. Enable ONLY with a dedicated demo Cal.com account.
# CALENDAR_PROVIDER=calcom
# CALCOM_API_KEY= (set in Railway Variables, never commit)
# CALCOM_EVENT_TYPE_ID= (numeric event type ID)

# Optional, separate staging-only admin console at /admin/calendar.
# PROVISIONING_ADMIN_PASSWORD= (unique random 32+ characters; Railway API service only)
# CALCOM_PROVISIONING_API_KEY= (reference to existing Railway shared secret)
# CALCOM_SCHEDULES_API_VERSION=2024-06-11
# CALCOM_EVENT_TYPES_API_VERSION=2026-06-12
